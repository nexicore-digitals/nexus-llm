{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "tests/src/plugins/PluginManager.test.ts",
    "tests/src/plugins/RegexPlugin.test.ts"
  ],
  "exclude": ["node_modules", "dist", "tests"]
}
